# Copy this file to ".env" and put your own values in. NEVER commit .env: it holds a database password.
# (.gitignore already excludes it.)

# Your MongoDB connection string, for example from MongoDB Atlas (Connect -> Drivers).
MONGODB_URI=mongodb+srv://<username>:<password>@<your-cluster-host>/?retryWrites=true&w=majority

# Name of the database to use. It is created automatically on first use.
DB_NAME=room_mgmt
